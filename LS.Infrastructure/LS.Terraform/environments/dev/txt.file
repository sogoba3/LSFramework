bucket = aws_s3_bucket.ls_framework_alb_logs.id
    
    policy = jsonencode({
      Version = "2012-10-17"
      Statement = [
        # 1. ENFORCE TLS IN-TRANSIT (Deny insecure requests)
        {
          Sid       = "EnforceTLSRequestsOnly"
          Effect    = "Deny"
          Principal = "*"
          Action    = "s3:*"
          Resource = [
            aws_s3_bucket.ls_framework_alb_logs.arn,
            "${aws_s3_bucket.ls_framework_alb_logs.arn}/*"
          ]
          Condition = {
            Bool = {
              "aws:SecureTransport" = "false"
            }
          }
        },
        # 2. ALLOW ALB TO WRITE LOGS
        {
          Sid    = "AllowALBToWriteLogs"
          Effect = "Allow"
          Principal = {
            Service = "logdelivery.elasticloadbalancing.amazonaws.com"
          }
          Action   = "s3:PutObject"
           Resource = "${aws_s3_bucket.ls_framework_alb_logs.arn}/AWSLogs/${data.aws_caller_identity.current.account_id}/*"
        },
        {
          Sid    = "AllowALBToReadBucketACL"
          Effect = "Allow"

          Principal = {
            Service = "logdelivery.elasticloadbalancing.amazonaws.com"
          }

          Action = [
            "s3:GetBucketAcl"
          ]

          Resource = aws_s3_bucket.ls_framework_alb_logs.arn
        }
      ]
  })