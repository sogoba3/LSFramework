# Auth User Api
module "ls_framework_auth_api" {
  # Source
  source = "../../modules/ls_framework_core"
  aws_region = "us-east-2"

  # Service Name
  service_name = var.service_names.auth_user_api_name

  # DNS Routing
  ls_framework_route53_zone_id     = module.ls_framework_dns_routing.ls_framework_route53_zone_id
  ls_framework_acm_certificate_arn = module.ls_framework_dns_routing.ls_framework_backend_cert_arn

  # Network
  ls_framework_vpc_id              = module.ls_framework_network.ls_framework_vpc_id
  ls_framework_private_subnets = module.ls_framework_network.ls_framework_private_subnets
  ls_framework_public_subnets  = module.ls_framework_network.ls_framework_public_subnets

  # load balancer
  alb_arn = aws_alb.ls_framework_internal_alb.arn

  # Data
  ls_framework_alb_logs = module.ls_framework_data.ls_framework_alb_logs

  ### api services configurations
  container_port     = var.api_services_config["auth-api"].container_port
  routing_port       = var.api_services_config["auth-api"].routing_port
  routing_test_port  = var.api_services_config["auth-api"].routing_test_port
  health_check_path  = var.api_services_config["auth-api"].health_check_path
  log_retention_days = var.api_services_config["auth-api"].log_retention_days
  cpu                = var.api_services_config["auth-api"].cpu
  memory             = var.api_services_config["auth-api"].memory
  desired_count      = var.api_services_config["auth-api"].desired_count

  # project environment context
  project_prefix = local.env_context.resource_prefix
}

