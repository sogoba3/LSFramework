{
  "family": "gateway-api-task-def",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::968715863111:role/ls-dev-gateway-api-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::968715863111:role/ls-dev-gateway-api-ecs-task-role",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "gateway-api",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4400,
          "hostPort": 4400
        }
      ],
      
      "secrets": [
        {
          "name": "ConnectionStrings__DefaultConnection",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:968715863111:secret:ls-dev/sqlserver13-d8jm9k"
        }
      ]
    }
  ]
}