{
  "family": "gateway-api-task-def",
  "networkMode": "awsvpc",
  "executionRoleArn": "<TASK_EXECUTION_ROLE_ARN>",
  "taskRoleArn": "<TASK_ROLE_ARN>",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "gateway-api",
      "image": "<IMAGE1_NAME>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4400,
          "hostPort": 4400
        }
      ],
      
      "secrets": [
        {
          "name": "ConnectionStrings__DefaultConnection",
          "valueFrom": "<SQLSERVER_SECRET_ARN>"
        }
      ]
    }
  ]
}