{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp.ReverseProxy": "Debug"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "auth-user": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/api/auth-user/{**catch-all}" }
      },
      "doctor": {
        "ClusterId": "doctorCluster",
        "Match": { "Path": "/api/doctor/{**catch-all}" }
      },
      "patient": {
        "ClusterId": "patientCluster",
        "Match": { "Path": "/api/patient/{**catch-all}" }
      },
      "billing": {
        "ClusterId": "billingCluster",
        "Match": { "Path": "/api/billing/{**catch-all}" }
      },
      "appointment": {
        "ClusterId": "appointmentCluster",
        "Match": { "Path": "/api/appointment/{**catch-all}" }
      },
      "notification": {
        "ClusterId": "notificationCluster",
        "Match": { "Path": "/api/notification/{**catch-all}" }
      },
      "tenant": {
        "ClusterId": "tenantCluster",
        "Match": { "Path": "/api/tenant/{**catch-all}" }
      },
      "audit": {
        "ClusterId": "auditCluster",
        "Match": { "Path": "/api/audit/{**catch-all}" }
      },
      "file": {
        "ClusterId": "fileServiceCluster",
        "Match": { "Path": "/api/file/{**catch-all}" }
      }
    },
    "Clusters": {
      "authCluster": { "Destinations": { "authApi": { "Address": "http://auth-api.ls-framework.local:4404/"} } },
      "doctorCluster": { "Destinations": { "doctorApi": { "Address": "http://doctor-api.ls-framework.local:4440/" } } },
      "patientCluster": { "Destinations": { "patientApi": { "Address": "http://patient-api.ls-framework.local:4442/" } } },
      "billingCluster": { "Destinations": { "billingApi": { "Address": "http://billing-api.ls-framework.local:4408/" } } },
      "appointmentCluster": { "Destinations": { "appointmentApi": { "Address": "http://appointment-api.ls-framework.local:4466/" } } },
      "notificationCluster": { "Destinations": { "notificationApi": { "Address": "http://notification-api.ls-framework.local:4428/" } } },
      "tenantCluster": { "Destinations": { "tenantApi": { "Address": "http://tenant-api.ls-framework.local:4482/" } } },
      "auditCluster": { "Destinations": { "auditApi": { "Address": "http://audit-api.ls-framework.local:4488/" } } },
      "fileServiceCluster": { "Destinations": { "fileServiceApi": { "Address": "http://file-service.ls-framework.local:4420/" } } }
      
      
    }
  }
}
